# Copy this file to .env and fill in your own values. Never commit .env.

# Required: Tavily web search API key
TAVILY_API_KEY=

# Required: Groq API key (used for the AI scholarship analysis)
GROQ_API_KEY=

# Optional: local backend port (default 5000). Vite's /api proxy uses the same value.
API_PORT=

# Optional: comma-separated origins allowed to call the API cross-origin.
# Leave empty when the frontend and API are served from the same site.
ALLOWED_ORIGINS=

# Optional search budget and limits. Leave empty to use the defaults described
# in README.md ("Configuration"); values outside the allowed range are clamped.
SEARCH_MAX_QUERIES=
RATE_LIMIT_MAX=
SEARCH_MAX_PER_HOUR=
CACHE_TTL_MS=
TAVILY_RAW_CONTENT=
AI_MODEL=
AI_REASONING_EFFORT=
