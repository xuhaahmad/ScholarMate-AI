# Copy this file to .env and fill in your own values. Never commit .env.

# Required: Tavily web search API key
TAVILY_API_KEY=

# Required: Groq API key (used for the AI scholarship analysis)
GROQ_API_KEY=

# Optional: local backend port (default 5000). Vite's /api proxy uses the same value.
API_PORT=

# Optional: comma-separated origins allowed to call the API cross-origin.
# Leave empty when the frontend and API are served from the same site.
ALLOWED_ORIGINS=
